/* 失主一侧用橙色，拾得者一侧用蓝色 */
page {
  --lost: #E0480F;
  --lost-tint: #FDE5D8;
  --lost-ink: #9A2F06;
  --found: #2459E0;
  --found-tint: #E1E9FB;
  --found-ink: #173E9E;
  --ground: #FFF8F3;
  --card: #FFFFFF;
  --line: #F1E2D8;
  --ink: #1C1B19;
  --quiet: #5F5C55;

  background: var(--ground);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 30rpx;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 24rpx;
}

.quiet {
  color: var(--quiet);
  font-size: 24rpx;
}

.btn {
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
}
.btn-lost { background: var(--lost); }
.btn-found { background: var(--found); }

.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}
.tag-lost { background: var(--lost-tint); color: var(--lost-ink); }
.tag-found { background: var(--found-tint); color: var(--found-ink); }

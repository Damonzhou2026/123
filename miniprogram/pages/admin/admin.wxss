.page { padding: 24rpx 32rpx 60rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.setup { display: flex; flex-direction: column; gap: 16rpx; line-height: 1.6; }
.title { font-size: 34rpx; font-weight: 700; }
.openid { font-family: monospace; font-size: 26rpx; word-break: break-all; background: var(--ground); border-radius: 16rpx; padding: 16rpx; }

.cards { display: flex; gap: 16rpx; }
.stat { flex: 1; display: flex; flex-direction: column; gap: 4rpx; padding: 20rpx; }
.num { font-size: 44rpx; font-weight: 700; }
.warn { color: #D93025; }

.section { font-size: 30rpx; font-weight: 700; margin: 32rpx 0 16rpx; }
.table { padding: 8rpx 16rpx; }
.tr { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; }
.tr:last-child { border-bottom: none; }
.th { color: var(--quiet); font-size: 22rpx; }
.td { flex: 1; text-align: right; font-variant-numeric: tabular-nums; }
.week { flex: 1.2; text-align: left; }
.rate { flex: 1.4; }
.note { margin-top: 16rpx; line-height: 1.6; }

.tag-gen { display: flex; flex-direction: column; gap: 16rpx; line-height: 1.6; }
.tag-row { display: flex; gap: 16rpx; }
.tag-input { flex: 1; height: 80rpx; border: 1rpx solid var(--line); border-radius: 16rpx; padding: 0 20rpx; }
.tag-input.wide { flex: 3; }
.tag-btn { height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 16rpx; background: var(--lost); color: #fff; font-weight: 700; }
.codes { display: flex; flex-wrap: wrap; gap: 12rpx; }
.code { font-family: monospace; font-size: 24rpx; background: var(--ground); border-radius: 12rpx; padding: 8rpx 12rpx; }
.qr { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.qr-img { width: 400rpx; height: 400rpx; }

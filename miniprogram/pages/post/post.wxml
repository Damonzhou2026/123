<view class="page {{isLost ? 'side-lost' : 'side-found'}}">
  <view wx:if="{{photoPaths.length === 0}}" class="photo" bindtap="choosePhoto">
    <view class="photo-empty">
      <view class="photo-title">{{isLost ? '上传物品照片' : '拍一张捡到的东西'}}</view>
      <view class="quiet">{{isLost ? '以前拍的照片、同款网图都可以' : '证件号、卡号等信息请遮挡后再拍'}}</view>
    </view>
  </view>
  <view wx:else class="photo-grid">
    <view wx:for="{{photoPaths}}" wx:key="*this" class="photo-cell">
      <image src="{{item}}" mode="aspectFill" class="photo-img" />
      <view class="photo-remove" data-index="{{index}}" catchtap="removePhoto">×</view>
    </view>
    <view wx:if="{{photoPaths.length < maxPhotos}}" class="photo-cell photo-add" bindtap="choosePhoto">+</view>
  </view>
  <view class="quiet photo-tip">最多 {{maxPhotos}} 张。多拍几个角度（正面、背面、有字或有特征的地方），AI 认得更准。</view>

  <view class="field">
    <view class="label">物品名称</view>
    <input class="input" placeholder="比如：一串钥匙，挂着小熊" value="{{title}}" bindinput="onTitle" maxlength="40" />
  </view>

  <view class="field">
    <view class="label">类别</view>
    <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
      <view class="input">{{categories[categoryIndex]}}</view>
    </picker>
    <input wx:if="{{categories[categoryIndex] === otherCategory}}" class="input custom-category" placeholder="具体是什么？比如：雨伞、充电宝"
           value="{{customCategory}}" bindinput="onCustomCategory" maxlength="{{maxCustomCategory}}" focus="{{categories[categoryIndex] === otherCategory}}" />
    <view wx:if="{{!isLost && privatePhoto}}" class="quiet hint">这类东西的照片不会在首页公开，只给附近登记了失物、可能是失主的人看。拍照时请遮住证件号、卡号。</view>
  </view>

  <view class="field">
    <view class="label">{{isLost ? '大概在哪丢的' : '在哪捡到的'}}</view>
    <view class="input" bindtap="chooseLocation">{{placeName || '点击选择位置'}}</view>
  </view>

  <view wx:if="{{isLost && rewardAllowed}}" class="field">
    <view class="label">感谢金（自愿）</view>
    <view class="rewards">
      <view wx:for="{{rewardOptions}}" wx:key="*this"
            class="reward {{!customReward && reward === item ? 'reward-on' : ''}}"
            bindtap="onReward" data-value="{{item}}">{{item === 0 ? '不设' : '¥' + item}}</view>
      <view class="reward {{customReward ? 'reward-on' : ''}}" bindtap="onCustomReward">其他</view>
    </view>
    <view wx:if="{{customReward}}" class="input custom-reward">
      <text class="yuan">¥</text>
      <input class="custom-input" type="number" placeholder="输入金额，1～{{maxReward}} 元" value="{{customRewardText}}"
             bindinput="onCustomRewardText" maxlength="5" focus="{{customReward}}" />
    </view>
    <view class="quiet hint">拿回物品时由你直接给拾得者，平台不经手。拾得者不能向你要价。</view>
  </view>
  <view wx:if="{{isLost && !rewardAllowed}}" class="quiet hint">证件类物品不设感谢金，建议同时联系派出所或场馆服务台。</view>

  <view wx:if="{{!isLost}}" class="field">
    <view class="label">核验问题（只有失主知道答案）</view>
    <input class="input" placeholder="比如：钥匙扣上挂的是什么？" value="{{verifyQuestion}}" bindinput="onVerify" maxlength="60" />
  </view>

  <view class="btn {{isLost ? 'btn-lost' : 'btn-found'}} submit" bindtap="submit">
    {{submitting ? '发布中…' : (isLost ? '发布并开始 AI 匹配' : '发布，帮它找主人')}}
  </view>

  <privacy-popup />
</view>

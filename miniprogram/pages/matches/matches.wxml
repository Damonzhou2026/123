<view class="page">
  <view wx:if="{{loading}}" class="quiet empty">AI 正在比对附近的物品…</view>

  <block wx:else>
    <view wx:if="{{postStatus === 'matched'}}" class="card done">
      <view class="summary">已经配对成功</view>
      <view class="quiet hint">接下来和对方约定交接的时间和地点。</view>
      <navigator class="btn {{isLost ? 'btn-lost' : 'btn-found'}} chat-btn" url="/pages/chat/chat?claimId={{matchedClaimId}}">去聊天</navigator>
    </view>

    <view wx:if="{{postStatus === 'blocked' && blockReason === 'reports'}}" class="card done">
      <view class="summary">这条发布被多人举报，已暂时下架</view>
      <view class="quiet hint">我们核实后会处理。如果有误会，请发邮件联系我们（邮箱在“我的发布”页面底部）。</view>
    </view>
    <view wx:elif="{{postStatus === 'blocked'}}" class="card done">
      <view class="summary">照片没有通过安全审核</view>
      <view class="quiet hint">这条发布已下架，别人看不到。请换一张只拍物品本身的照片重新发布。</view>
    </view>

    <view wx:if="{{postStatus === 'withdrawn'}}" class="card done">
      <view class="summary">这条发布已撤回</view>
      <view class="quiet hint">别人已经搜不到、也认领不了它了。想彻底删除，可以在“我的发布”里点“管理”。</view>
    </view>

    <!-- 拾得者：别人发来的认领 -->
    <block wx:if="{{!isLost && claims.length > 0}}">
      <view class="summary">{{claims.length}} 个人来认领</view>
      <view wx:for="{{claims}}" wx:key="_id" class="card claim">
        <view class="photos">
          <image class="photo photo-lost" src="{{item.lostPhoto}}" mode="aspectFill" />
          <image class="photo photo-found" src="{{myPhoto}}" mode="aspectFill" />
        </view>
        <view class="quiet">你的问题：{{item.question}}</view>
        <view class="answer">对方的回答：{{item.answer}}</view>
        <view wx:if="{{item.status === 'pending'}}" class="claim-actions">
          <view class="btn btn-ghost" bindtap="reviewClaim" data-id="{{item._id}}" data-approve="{{false}}">答案不对</view>
          <view class="btn btn-found" bindtap="reviewClaim" data-id="{{item._id}}" data-approve="{{true}}">是失主，确认</view>
        </view>
        <view wx:elif="{{item.status === 'approved'}}" class="tag tag-found">已确认</view>
        <view wx:elif="{{item.status === 'cancelled'}}" class="quiet">配对已取消</view>
        <view wx:else class="quiet">已拒绝</view>
        <text class="quiet report-link" catchtap="report" data-type="claim" data-id="{{item._id}}">举报这个认领人</text>
      </view>
    </block>

    <!-- 匹配结果 -->
    <block wx:if="{{postStatus === 'open'}}">
      <view class="summary">
        {{matches.length > 0 ? 'AI 找到 ' + matches.length + ' 个可能的匹配' : '暂时还没有匹配的物品'}}
      </view>
      <view wx:if="{{matches.length === 0}}" class="quiet hint">
        发布已经生效。有新的{{isLost ? '拾得者' : '失主'}}上传时，我们会第一时间提醒你。
      </view>
      <button class="btn {{isLost ? 'btn-lost' : 'btn-found'}} share-btn" open-type="share">
        {{isLost ? '转发到班级群、宿舍群，让大家帮忙留意' : '转发到群里，帮它找主人'}}
      </button>

      <view wx:for="{{matches}}" wx:key="_id" class="card match {{index === 0 ? 'match-top' : ''}}">
        <view class="match-head">
          <text wx:if="{{item.linked}}" class="tag tag-found">对方说捡到了你的</text>
          <text wx:else class="tag {{isLost ? 'tag-found' : 'tag-lost'}}">{{item.imageCompared ? '看图匹配' : '匹配度'}} {{item.scoreText}}</text>
          <text class="quiet">{{item.distanceText}} · {{item.timeText}}</text>
        </view>
        <view class="photos">
          <image class="photo photo-lost" src="{{isLost ? myPhoto : item.photos[0]}}" mode="aspectFill" />
          <image class="photo photo-found" src="{{isLost ? item.photos[0] : myPhoto}}" mode="aspectFill" />
        </view>
        <view class="match-title">{{item.title}}</view>
        <view class="match-foot">
          <text class="quiet">{{item.placeName}}</text>
          <text class="quiet report-link" catchtap="report" data-type="post" data-id="{{item._id}}">举报</text>
        </view>

        <view wx:if="{{isLost && item.claimText}}" class="claim-status">{{item.claimText}}</view>
        <view wx:elif="{{isLost && item.verifyQuestion}}" class="verify">
          <view class="verify-q">拾得者想确认一下：{{item.verifyQuestion}}</view>
          <input class="verify-input" placeholder="只有失主知道的答案" maxlength="60"
                 value="{{answers[item._id]}}" bindinput="onAnswer" data-id="{{item._id}}" />
          <view class="btn btn-lost" bindtap="submitClaim" data-id="{{item._id}}">回答并认领</view>
        </view>
      </view>
    </block>
  </block>
</view>

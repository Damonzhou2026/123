.page { padding: 24rpx 40rpx 80rpx; }
.side-lost { --accent: var(--lost); }
.side-found { --accent: var(--found); }
.empty { text-align: center; padding: 120rpx 0; }

.photos { height: 480rpx; border-radius: 32rpx; overflow: hidden; background: var(--card); }
.photo { width: 100%; height: 100%; }
.photo-hidden {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 3rpx dashed var(--accent);
  box-sizing: border-box;
}
.photo-hidden-title { font-size: 40rpx; font-weight: 700; color: var(--accent); }

.info { margin: 24rpx 0; display: flex; flex-direction: column; gap: 12rpx; }
.title { font-size: 34rpx; font-weight: 700; margin-left: 12rpx; }
.reward { font-weight: 700; color: var(--lost-ink); }
.hint { line-height: 1.6; margin-bottom: 16rpx; }

.done { line-height: 1.6; margin-bottom: 24rpx; }
.chat-btn { margin-top: 20rpx; }

.verify { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.verify-q { font-size: 28rpx; }
.verify-input {
  height: 88rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 0 24rpx;
  background: var(--ground);
}

button.btn { padding: 0; border: none; }
button.btn::after { border: none; }
.btn-share { background: var(--accent); margin-bottom: 20rpx; }
.btn-ghost { color: var(--ink); background: var(--card); border: 1rpx solid var(--line); font-weight: 500; }
button.btn-ghost { border: 1rpx solid var(--line); }
.share-ghost { margin-top: 20rpx; }
.report { text-align: center; margin-top: 48rpx; text-decoration: underline; }

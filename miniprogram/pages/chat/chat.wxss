/* 自己的气泡用自己一侧的颜色：失主橙色，拾得者蓝色 */
.me-lost { --mine: var(--lost); --other-tint: var(--found-tint); }
.me-found { --mine: var(--found); --other-tint: var(--lost-tint); }

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
}

.item { display: flex; gap: 20rpx; align-items: center; }
.item-photo { width: 96rpx; height: 96rpx; border-radius: 20rpx; background: var(--line); flex: none; }
.item-body { display: flex; flex-direction: column; gap: 6rpx; }
.item-title { font-weight: 700; }

.notice { margin: 20rpx 8rpx; line-height: 1.6; }
.link { color: var(--mine); font-weight: 600; }

.messages { flex: 1; min-height: 0; }
.empty { text-align: center; padding: 80rpx 0; }
.row { display: flex; margin-bottom: 20rpx; }
.row-mine { justify-content: flex-end; }
.bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.bubble-mine { background: var(--mine); color: #FFFFFF; border-radius: 32rpx 32rpx 8rpx 32rpx; }
.bubble-other { background: var(--other-tint); color: var(--ink); border-radius: 32rpx 32rpx 32rpx 8rpx; }

.quick { display: flex; gap: 16rpx; flex-wrap: wrap; padding: 12rpx 0; }
.quick-item {
  font-size: 24rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}

.composer { display: flex; gap: 16rpx; align-items: center; padding: 12rpx 0 48rpx; }
.composer-input {
  flex: 1;
  height: 88rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 0 28rpx;
  background: var(--card);
}
.send {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--mine);
  color: #FFFFFF;
  font-weight: 700;
}

.confirm { margin-top: 20rpx; }
.rate { margin-top: 20rpx; display: flex; flex-direction: column; gap: 20rpx; }
.rate-title { font-weight: 700; }
.stars { display: flex; gap: 12rpx; }
.star { font-size: 56rpx; color: var(--line); min-width: 72rpx; min-height: 72rpx; text-align: center; }
.star-on { color: #F59E0B; }
.tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-option { font-size: 24rpx; border: 1rpx solid var(--line); border-radius: 999rpx; padding: 10rpx 24rpx; background: var(--card); }
.tag-option-on { border-color: var(--mine); color: var(--mine); font-weight: 700; }

.reward { margin-top: 20rpx; display: flex; flex-direction: column; gap: 12rpx; }
.reward-lost { background: var(--lost-tint); border-color: var(--lost-tint); }
.reward-found { background: var(--found-tint); border-color: var(--found-tint); }
.reward-amount { font-size: 34rpx; font-weight: 700; }
.handover { margin-top: 20rpx; display: flex; flex-direction: column; gap: 8rpx; }
.handover-place { font-weight: 700; }
.btn-ghost { background: var(--card); color: var(--ink); border: 1rpx solid var(--line); font-weight: 500; }
.cancelled { margin-top: 20rpx; display: flex; flex-direction: column; gap: 8rpx; }
.cancelled-title { font-weight: 700; }

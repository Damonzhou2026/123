.page { padding: 24rpx 40rpx 60rpx; }
.slogan { font-size: 28rpx; color: var(--quiet); }

.actions {
  display: flex;
  gap: 24rpx;
  margin: 32rpx 0 48rpx;
}
.action {
  flex: 1;
  min-height: 240rpx;
  border-radius: 40rpx;
  padding: 32rpx;
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
}
.action-lost { background: var(--lost); }
.action-found { background: var(--found); }
.action-title { font-size: 36rpx; font-weight: 700; }
.action-sub { font-size: 24rpx; opacity: 0.9; margin-top: 4rpx; }

.section-title { font-size: 34rpx; font-weight: 700; margin-bottom: 20rpx; }
.empty { text-align: center; padding: 60rpx 0; }
.link { color: var(--lost); margin-top: 16rpx; }

.item { display: flex; gap: 24rpx; align-items: center; margin-bottom: 20rpx; }
.thumb { width: 128rpx; height: 128rpx; border-radius: 24rpx; background: var(--line); flex: none; }
.item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.item-title { font-weight: 500; margin-left: 12rpx; }

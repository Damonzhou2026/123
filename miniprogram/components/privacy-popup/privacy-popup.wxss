.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(28, 27, 25, 0.5);
  display: flex;
  align-items: flex-end;
}
.panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.title { font-size: 36rpx; font-weight: 700; margin-bottom: 24rpx; }
.body { font-size: 28rpx; line-height: 1.7; color: #1C1B19; margin-bottom: 16rpx; }
.doc-link { color: #9A2F06; font-weight: 700; }
.agree {
  margin-top: 32rpx;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 28rpx;
  background: #E0480F;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
}
.agree::after { border: none; }
.disagree { text-align: center; color: #5F5C55; font-size: 28rpx; padding: 24rpx 0 8rpx; }
.quiet { color: #5F5C55; font-size: 24rpx; }
.note { text-align: center; }
